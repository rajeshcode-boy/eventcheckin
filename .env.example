# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL=your_postgres_connection_string_here

# Web push notifications (generate once with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:you@example.com

# PostHog product analytics (optional; analytics and the cookie banner stay off until the key is set)
# Project key from PostHog > Project settings, starts with phc_
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_key_here
# https://us.i.posthog.com for US Cloud, https://eu.i.posthog.com for EU Cloud
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Analytics 4 (optional; public website pages only, after cookie consent)
# Measurement ID from GA Admin > Data streams > your web stream, starts with G-
NEXT_PUBLIC_GA_ID=your_ga4_measurement_id_here
